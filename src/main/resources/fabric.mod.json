	"authors": [
		"Antigravity"
	],
	"contact": {
		"sources": "https://github.com/geoguessr/mc-geoguessr"
	},
	"license": "MIT",
	"icon": "assets/geoguessr/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.geoguessr.GeoGuessrMod"
		],
		"client": [
			"com.geoguessr.client.GeoGuessrModClient"
		]
	},
	"mixins": [
		"geoguessr.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
